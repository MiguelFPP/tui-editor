COMPOSE ?= docker compose

.DEFAULT_GOAL := help

.PHONY: help dev run build test vet fmt tidy clean

help: ## List available targets
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z_-]+:.*##/ {printf "  \033[36m%-7s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

dev: ## Run the TUI with hot reload (needs a TTY)
	$(COMPOSE) run --rm dev

run: ## Run the TUI from the production image (needs a TTY)
	$(COMPOSE) --profile prod run --rm app

build: ## Build the Docker images
	$(COMPOSE) --profile prod build

test: ## Run go test inside the dev container
	$(COMPOSE) run --rm --no-deps -T dev go test ./...

vet: ## Run go vet inside the dev container
	$(COMPOSE) run --rm --no-deps -T dev go vet ./...

fmt: ## Run go fmt inside the dev container
	$(COMPOSE) run --rm --no-deps -T dev go fmt ./...

tidy: ## Run go mod tidy inside the dev container
	$(COMPOSE) run --rm --no-deps -T dev go mod tidy

clean: ## Remove build artifacts generated by Air
	$(COMPOSE) run --rm --no-deps -T dev rm -rf tmp bin
